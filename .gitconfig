[user]
	name = Cliff Lau
	email = cliff@clifflau.hk

[core]
	eol = lf
	autocrlf = input
	editor = nvim
	pager = delta
	excludesfile = /Users/cliff/.gitignore_global

[init]
	defaultBranch = main

[delta]
    navigate = true  # use n and N to move between diff sections

[push]
    autoSetupRemote = true

[interactive]
    diffFilter = delta --color-only

[merge]
    conflictStyle = zdiff3

[include]
    path = .gitaliases

[includeIf "gitdir:/home/cliff/code/clifflau1120/"]
    path = .gitconfig-personal

[includeIf "gitdir:/Users/cliff.lau/code/clifflau1120/"]
    path = .gitconfig-personal

[includeIf "gitdir:/home/cliff/code/qdev/"]
    path = .gitconfig-lgt

[includeIf "gitdir:/Users/cliff.lau/code/qdev/"]
    path = .gitconfig-lgt
