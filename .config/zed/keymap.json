// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
[
    {
        "bindings": {
            "ctrl-shift-left": null,
            "ctrl-shift-up": null,
            "ctrl-shift-down": null,
            "ctrl-shift-right": null,
        },
    },
    {
        "context": "Pane",
        "bindings": {
            "cmd-shift-f": "workspace::NewSearch",
        },
    },
    {
        "context": "Workspace",
        "bindings": {
            "cmd-k cmd-shift-left": [
                "workspace::MoveItemToPaneInDirection",
                ["left"],
            ],
            "cmd-k cmd-shift-up": [
                "workspace::MoveItemToPaneInDirection",
                ["up"],
            ],
            "cmd-k cmd-shift-down": [
                "workspace::MoveItemToPaneInDirection",
                ["down"],
            ],
            "cmd-k cmd-shift-right": [
                "workspace::MoveItemToPaneInDirection",
                ["right"],
            ],
        },
    },
    {
        "context": "ProjectPanel",
        "bindings": {
            "cmd-1": "project_panel::CollapseSelectedEntry",
            "cmd-!": "project_panel::CollapseAllEntries",
        },
    },
    {
        "context": "OutlinePanel",
        "bindings": {
            "cmd-1": "outline_panel::CollapseSelectedEntry",
            "cmd-!": "outline_panel::CollapseAllEntries",
        },
    },
    {
        "context": "Editor && mode == full",
        "bindings": {
            "cmd-1": "editor::ToggleFold",
            "cmd-!": "editor::ToggleFoldRecursive",
            "cmd-2": "git::Blame",
            "ctrl-t": "file_finder::Toggle",
            "cmd-shift-x": "editor::CopyPermalinkToLine",
            "cmd-shift-c": "workspace::CopyRelativePath",
            "f5": "editor::SpawnNearestTask",
            "shift-f5": "task::Spawn",
            "ctrl-shift-e": "vim::LineUp",
            "ctrl-shift-y": "vim::LineDown",
        },
    },
    {
        "context": "Terminal",
        "bindings": {
            "ctrl-e": "terminal::ScrollLineDown",
            "ctrl-shift-e": "terminal::ScrollLineUp",
            "ctrl-y": "terminal::ScrollLineUp",
            "ctrl-shift-y": "terminal::ScrollLineDown",
        },
    },
]
